{
  "name": "mind-the-dock-v5",
  "version": "5.0.0",
  "private": true,
  "description": "Mind The Dock V4: responsive map and complete station insights with bundled recorded data",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "data:prepare": "python3 scripts/prepare-showcase.py",
    "data:import": "node scripts/import-csv.js",
    "data:three-days": "node scripts/prepare-three-days.js",
    "collect:once": "node scripts/collect-once.js",
    "db:init": "node scripts/db-tools.js init",
    "db:seed": "node scripts/db-tools.js seed",
    "db:export": "node scripts/db-tools.js export",
    "db:import": "node scripts/db-tools.js import",
    "db:verify": "node scripts/db-tools.js verify",
    "test:import": "node scripts/verify-snapshot.js"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "mysql2": "^3.15.3"
  }
}
