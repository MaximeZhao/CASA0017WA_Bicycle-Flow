# 1. 数据库密码和 API Key
.env
.env.local

# 2. Node.js 安装的依赖
node_modules/

# 3. 日志文件
*.log
npm-debug.log*

# 4. 系统临时文件
.DS_Store
Thumbs.db

# 5. 本地导出的数据文件
data/exports/
# .env	包含 MySQL 用户名、密码和 API Key
# node_modules/	Node.js 依赖文件夹，可以通过 npm install 重新安装
# *.log	程序运行时产生的日志
# .DS_Store、Thumbs.db	macOS 和 Windows 自动生成的系统文件
# data/exports/	本地导出的 CSV 数据文件